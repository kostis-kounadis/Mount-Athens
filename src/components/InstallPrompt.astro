---
// Component for mobile-only PWA install prompt
const baseUrl = import.meta.env.BASE_URL;
---

<!-- Mobile App Install Floating Prompt Banner -->
<aside
  id="pwa-install-banner"
  role="region"
  aria-label="Εγκατάσταση Εφαρμογής"
  class="fixed bottom-3 inset-x-3 z-50 transform translate-y-32 opacity-0 transition-all duration-300 ease-out pointer-events-none md:hidden"
  style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));"
>
  <div class="max-w-md mx-auto bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl shadow-xl shadow-slate-900/10 p-3.5 flex items-center justify-between gap-3 text-slate-800">
    <!-- App Icon & Info -->
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-11 h-11 rounded-xl bg-slate-900 flex items-center justify-center flex-shrink-0 shadow-sm border border-slate-800">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" viewBox="0 0 24 24">
          <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
        </svg>
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-sm text-slate-900 truncate">Mount Athens</span>
          <span class="text-[9px] font-semibold text-slate-500 uppercase tracking-wider px-1.5 py-0.2 bg-slate-100 rounded">APP</span>
        </div>
        <p class="text-xs text-slate-500 truncate mt-0.5">Εγκατάσταση στην αρχική οθόνη</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <button
        id="pwa-install-btn"
        type="button"
        class="inline-flex items-center justify-center px-3.5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 active:scale-95 rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2"
      >
        Εγκατάσταση
      </button>
      <button
        id="pwa-dismiss-btn"
        type="button"
        aria-label="Κλείσιμο προτροπής εγκατάστασης"
        class="p-2 text-slate-400 hover:text-slate-600 active:text-slate-900 rounded-xl transition-colors focus:outline-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- iOS / Manual Instruction Modal / Bottom Sheet -->
<div
  id="pwa-instructions-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pwa-modal-title"
  class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm transition-opacity duration-200 md:hidden flex items-end sm:items-center justify-center p-3"
>
  <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl border border-slate-200 p-5 space-y-4 text-slate-800 animate-slide-up">
    <!-- Modal Header -->
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-900 flex items-center justify-center shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white" viewBox="0 0 24 24">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
          </svg>
        </div>
        <div>
          <h3 id="pwa-modal-title" class="text-sm font-bold text-slate-900">Προσθήκη στην Αρχική Οθόνη</h3>
          <p class="text-xs text-slate-500">Οδηγίες εγκατάστασης</p>
        </div>
      </div>
      <button
        id="pwa-modal-close"
        type="button"
        aria-label="Κλείσιμο οδηγιών"
        class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </div>

    <!-- Instructions Body (iOS Safari or Android browser steps) -->
    <div id="pwa-steps-ios" class="space-y-3 text-xs text-slate-700">
      <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-[11px]">1</span>
        <div class="pt-0.5">
          Πατήστε το κουμπί <strong>Κοινοποίηση (Share)</strong>
          <span class="inline-flex items-center align-middle mx-1 p-1 bg-white border border-slate-200 rounded shadow-xs">
            <!-- iOS share icon -->
            <svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <polyline points="16 6 12 2 8 6"></polyline>
              <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
          </span>
          στη γραμμή εργαλείων του Safari.
        </div>
      </div>

      <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-[11px]">2</span>
        <div class="pt-0.5">
          Κυλήστε προς τα κάτω και πατήστε <strong>«Προσθήκη στην οθόνη αφετηρίας»</strong>
          <span class="inline-flex items-center align-middle mx-1 p-1 bg-white border border-slate-200 rounded shadow-xs">
            <!-- Add to home icon -->
            <svg class="w-3.5 h-3.5 text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <line x1="12" y1="8" x2="12" y2="16"></line>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
          </span>.
        </div>
      </div>

      <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-[11px]">3</span>
        <div class="pt-0.5">
          Πατήστε <strong>«Προσθήκη»</strong> πάνω δεξιά. Το εικονίδιο του <strong>Mount Athens</strong> θα εμφανιστεί στην οθόνη σας!
        </div>
      </div>
    </div>

    <!-- Generic instructions for other browsers -->
    <div id="pwa-steps-generic" class="hidden space-y-3 text-xs text-slate-700">
      <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-[11px]">1</span>
        <div class="pt-0.5">
          Πατήστε το μενού επιλογών του περιηγητή σας (συνήθως <strong>τρεις τελείες ⋮</strong> πάνω ή κάτω).
        </div>
      </div>
      <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white font-bold flex items-center justify-center text-[11px]">2</span>
        <div class="pt-0.5">
          Επιλέξτε <strong>«Εγκατάσταση εφαρμογής»</strong> ή <strong>«Προσθήκη στην αρχική οθόνη»</strong>.
        </div>
      </div>
    </div>

    <!-- Modal Button -->
    <button
      id="pwa-modal-ack"
      type="button"
      class="w-full py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl transition-all focus:outline-none"
    >
      Εντάξει, κατάλαβα
    </button>
  </div>
</div>

<style>
  @media (min-width: 768px) {
    #pwa-install-banner,
    #pwa-instructions-modal {
      display: none !important;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-up {
    animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script is:inline define:vars={{ baseUrl }}>
  (function () {
    const STORAGE_KEY = 'mount_athens_install_prompt_dismissed_at';
    const DISMISS_COOLDOWN_MS = 14 * 24 * 60 * 60 * 1000; // 14 days

    let deferredPrompt = null;
    const banner = document.getElementById('pwa-install-banner');
    const installBtn = document.getElementById('pwa-install-btn');
    const dismissBtn = document.getElementById('pwa-dismiss-btn');
    const modal = document.getElementById('pwa-instructions-modal');
    const modalClose = document.getElementById('pwa-modal-close');
    const modalAck = document.getElementById('pwa-modal-ack');
    const stepsIos = document.getElementById('pwa-steps-ios');
    const stepsGeneric = document.getElementById('pwa-steps-generic');

    // Register Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        const swUrl = baseUrl.endsWith('/') ? baseUrl + 'sw.js' : baseUrl + '/sw.js';
        navigator.serviceWorker.register(swUrl).catch(function (err) {
          console.warn('SW registration failed:', err);
        });
      });
    }

    // Check if running in standalone mode (already installed as PWA)
    function isRunningStandalone() {
      return (
        window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true ||
        document.referrer.includes('android-app://')
      );
    }

    // Check if currently on mobile
    function isMobileDevice() {
      const userAgent = navigator.userAgent || navigator.vendor || (window).opera;
      const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
      const isNarrowScreen = window.innerWidth < 768;
      const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
      return (isMobileUA || (isNarrowScreen && isTouch));
    }

    // Check if user dismissed prompt recently
    function isDismissed() {
      try {
        const lastDismissed = localStorage.getItem(STORAGE_KEY);
        if (!lastDismissed) return false;
        const timeElapsed = Date.now() - parseInt(lastDismissed, 10);
        return timeElapsed < DISMISS_COOLDOWN_MS;
      } catch (e) {
        return false;
      }
    }

    // Dismiss prompt
    function dismissPrompt() {
      try {
        localStorage.setItem(STORAGE_KEY, Date.now().toString());
      } catch (e) {}
      hideBanner();
    }

    function showBanner() {
      if (!banner) return;
      banner.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
    }

    function openModal() {
      if (!modal) return;
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      if (isIOS) {
        if (stepsIos) stepsIos.classList.remove('hidden');
        if (stepsGeneric) stepsGeneric.classList.add('hidden');
      } else {
        if (stepsIos) stepsIos.classList.add('hidden');
        if (stepsGeneric) stepsGeneric.classList.remove('hidden');
      }
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      dismissPrompt();
    }

    // Initial checks
    if (isRunningStandalone() || !isMobileDevice() || isDismissed()) {
      return;
    }

    // Capture beforeinstallprompt for Chromium browsers
    window.addEventListener('beforeinstallprompt', function (e) {
      // Prevent browser default mini-infobar
      e.preventDefault();
      deferredPrompt = e;
      // Show our custom mobile prompt after a short delay for smooth page entrance
      setTimeout(showBanner, 1500);
    });

    // Detect iOS Safari or mobile browsers where beforeinstallprompt doesn't fire
    window.addEventListener('DOMContentLoaded', function () {
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      // On iOS Safari, beforeinstallprompt never fires. Show prompt after page load.
      if (isIOS && !isRunningStandalone() && !isDismissed()) {
        setTimeout(showBanner, 2000);
      }
    });

    // Install button click handler
    if (installBtn) {
      installBtn.addEventListener('click', async function () {
        if (deferredPrompt) {
          // Native Chromium install prompt
          deferredPrompt.prompt();
          const choiceResult = await deferredPrompt.userChoice;
          if (choiceResult.outcome === 'accepted') {
            hideBanner();
          }
          deferredPrompt = null;
        } else {
          // iOS Safari or browser without deferred prompt - open instructions
          openModal();
        }
      });
    }

    // Dismiss button click handler
    if (dismissBtn) {
      dismissBtn.addEventListener('click', dismissPrompt);
    }

    // Modal close handlers
    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalAck) modalAck.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
    }

    // When app is successfully installed, hide banner and clear state
    window.addEventListener('appinstalled', function () {
      deferredPrompt = null;
      hideBanner();
      try {
        localStorage.setItem(STORAGE_KEY, (Date.now() + 365 * 24 * 60 * 60 * 1000).toString());
      } catch (e) {}
    });
  })();
</script>
