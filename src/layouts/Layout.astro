---
import SEO from '../components/SEO.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import pkg from '../../package.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  mainClass?: string;
  footerClass?: string;
}

const { title, description, image, mainClass = "max-w-5xl mx-auto px-4 sm:px-6 lg:px-8", footerClass = "max-w-5xl mx-auto px-4" } = Astro.props;
---

<!doctype html>
<html lang="el" class="scroll-smooth">
  <head>
    <SEO title={title} description={description} image={image} />
    <style is:global>
      :root {
        --color-bg: #f8fafc; /* Slate 50 */
        --color-surface: #ffffff;
        --color-border: #e2e8f0; /* Slate 200 */
        --color-text: #0f172a; /* Slate 900 */
        --color-text-muted: #64748b; /* Slate 500 */
        --color-accent: #0f172a;
        --font-sans: 'IBM Plex Sans', sans-serif;
        --font-mono: 'IBM Plex Mono', monospace;
      }

      /* Custom scrollbar styling */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--color-bg);
      }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }

      html {
        overflow-y: scroll;
      }
      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
        overflow-x: clip;
      }

      button, input, select, textarea {
        font-family: inherit;
      }

      .text-mono {
        font-family: var(--font-mono);
      }

      /* Respect prefers-reduced-motion globally */
      @media (prefers-reduced-motion: reduce) {
        *,
        ::before,
        ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-slate-200 selection:text-slate-800">

    <!-- Global Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
      <div class="py-3.5 sm:py-5 md:py-6 px-4 sm:px-6 md:px-12 flex items-center justify-between gap-3">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 sm:gap-2.5 group focus:outline-none min-w-0">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-slate-900 group-hover:scale-110 transition-transform duration-200 flex-shrink-0" viewBox="0 0 24 24">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
          </svg>
          <span class="font-bold tracking-tight text-sm sm:text-lg text-slate-900 font-sans leading-tight flex items-center gap-1.5 sm:gap-2 whitespace-nowrap">
            Ορειβατικό Ημερολόγιο
            <span class="hidden sm:inline-block text-[10px] font-light text-orange-500 uppercase tracking-widest px-1.5 py-0.5 border border-orange-200 rounded-md bg-orange-50/50 select-none">BETA</span>
          </span>
        </a>
        
        <!-- Desktop Navigation (sm and up) -->
        <nav aria-label="Κύρια πλοήγηση" class="hidden sm:flex items-center gap-6 sm:gap-8 font-sans text-xs sm:text-sm font-medium text-slate-600 flex-shrink-0">
          <a href={import.meta.env.BASE_URL + "info"} class="hover:text-slate-900 transition-colors">
            Πληροφορίες
          </a>
          <a 
            href={import.meta.env.BASE_URL + "notifications"} 
            class="inline-flex items-center gap-1.5 hover:text-slate-900 transition-colors"
          >
            <span>Ενημερώσεις</span>
            <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
          </a>
        </nav>

        <!-- Mobile Hamburger Toggle Button (below sm) -->
        <button 
          id="mobile-nav-toggle"
          type="button"
          aria-label="Μενού πλοήγησης"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          class="sm:hidden p-2 -mr-1 text-slate-700 hover:text-slate-900 hover:bg-slate-100 active:bg-slate-200 rounded-lg focus:outline-none transition-colors"
        >
          <!-- Hamburger Icon (Open state) -->
          <svg id="hamburger-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Close Icon (Close state) -->
          <svg id="hamburger-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown Menu (below sm) -->
      <nav 
        id="mobile-nav-menu" 
        aria-label="Μενού κινητού"
        class="hidden sm:hidden border-t border-slate-100 bg-white/95 backdrop-blur-sm px-4 py-3 flex flex-col gap-1 font-sans text-sm font-medium text-slate-700 shadow-md"
      >
        <a 
          href={import.meta.env.BASE_URL + "info"} 
          class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg hover:bg-slate-100 active:bg-slate-200 text-slate-800 transition-colors"
        >
          <span>Πληροφορίες</span>
        </a>
        <a 
          href={import.meta.env.BASE_URL + "notifications"} 
          class="flex items-center gap-2 px-3 py-2.5 rounded-lg hover:bg-slate-100 active:bg-slate-200 text-slate-800 transition-colors"
        >
          <span>Ενημερώσεις</span>
          <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
          </svg>
        </a>
      </nav>
    </header>

    <!-- Main Content Area -->
    <main class={`flex-grow w-full py-8 md:py-12 ${mainClass}`}>
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-slate-200 bg-white py-8 text-[11px] text-slate-500 flex-shrink-0">
      <div class={`w-full flex flex-col sm:flex-row items-center justify-between gap-4 ${footerClass}`}>
        <a href={import.meta.env.BASE_URL} class="font-mono text-slate-600 uppercase tracking-widest text-center sm:text-left hover:text-slate-900 transition-colors">
          ΟΡΕΙΒΑΤΙΚΟ ΗΜΕΡΟΛΟΓΙΟ
        </a>
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-5 font-mono">
          <a href={import.meta.env.BASE_URL + "info"} class="hover:underline transition-colors hover:text-slate-900">ΠΛΗΡΟΦΟΡΙΕΣ</a>
          <span class="text-slate-300">/</span>
          <a href={import.meta.env.BASE_URL + "info#report"} class="hover:underline transition-colors hover:text-slate-900">ΑΝΑΦΟΡΑ ΠΡΟΒΛΗΜΑΤΟΣ</a>
          <span class="text-slate-300">/</span>
          <a href={import.meta.env.BASE_URL + "notifications"} class="hover:underline transition-colors hover:text-slate-900">ΕΝΗΜΕΡΩΣΕΙΣ</a>
          <span class="text-slate-300">/</span>
          <span class="font-bold text-slate-800">v{pkg.version}</span>
        </div>
      </div>
    </footer>

    <!-- Service Worker Registration for PWA Support -->
    <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
      if ('serviceWorker' in navigator) {
        const isLocalHost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        window.addEventListener('load', () => {
          if (isLocalHost) {
            navigator.serviceWorker.getRegistrations().then((registrations) => {
              registrations.forEach((reg) => reg.unregister());
            });
            if ('caches' in window) {
              caches.keys().then((keys) => {
                keys.forEach((key) => caches.delete(key));
              });
            }
            return;
          }
          const swUrl = baseUrl.endsWith('/') ? baseUrl + 'sw.js' : baseUrl + '/sw.js';
          navigator.serviceWorker.register(swUrl).catch((err) => {
            console.debug('ServiceWorker registration error:', err);
          });
        });
      }

      // Mobile Navigation Menu Toggle
      const navToggle = document.getElementById('mobile-nav-toggle');
      const navMenu = document.getElementById('mobile-nav-menu');
      const iconOpen = document.getElementById('hamburger-icon-open');
      const iconClose = document.getElementById('hamburger-icon-close');

      function closeMobileNav() {
        if (!navMenu || navMenu.classList.contains('hidden')) return;
        navMenu.classList.add('hidden');
        if (navToggle) navToggle.setAttribute('aria-expanded', 'false');
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
      }

      if (navToggle && navMenu) {
        navToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
          const nextState = !isExpanded;
          navToggle.setAttribute('aria-expanded', String(nextState));
          navMenu.classList.toggle('hidden');
          if (iconOpen) iconOpen.classList.toggle('hidden', nextState);
          if (iconClose) iconClose.classList.toggle('hidden', !nextState);
        });

        // Close on clicking outside
        document.addEventListener('click', (e) => {
          if (!navMenu.classList.contains('hidden') && !navMenu.contains(e.target) && !navToggle.contains(e.target)) {
            closeMobileNav();
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !navMenu.classList.contains('hidden')) {
            closeMobileNav();
            navToggle.focus();
          }
        });

        // Close if resizing above mobile breakpoint
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 640) {
            closeMobileNav();
          }
        });
      }
    </script>

    <!-- Mobile-only App Install Prompt -->
    <InstallPrompt />
  </body>
</html>
