---
import Layout from '../layouts/Layout.astro';
import eventsData from '../data/events.json';
import statusData from '../data/status.json';
import crypto from 'node:crypto';

function getEventAnchor(ev: { club?: string; startDate?: string; title?: string }) {
  const club = (ev.club || '').trim();
  const startDate = (ev.startDate || '').trim();
  const title = (ev.title || '').trim();
  const hash = crypto.createHash('sha256').update(`${club}::${startDate}::${title}`).digest('hex').slice(0, 8);
  return `ev-${startDate}-${hash}`;
}

const GREEK_MONTHS = [
  "Ιανουάριος", "Φεβρουάριος", "Μάρτιος", "Απρίλιος", "Μάιος", "Ιούνιος",
  "Ιούλιος", "Αύγουστος", "Σεπτέμβριος", "Οκτώβριος", "Νοέμβριος", "Δεκέμβριος"
];

const GREEK_DAYS_FULL = ["ΚΥΡΙΑΚΗ", "ΔΕΥΤΕΡΑ", "ΤΡΙΤΗ", "ΤΕΤΑΡΤΗ", "ΠΕΜΠΤΗ", "ΠΑΡΑΣΚΕΥΗ", "ΣΑΒΒΑΤΟ"];
const GREEK_MONTHS_FULL = [
  "ΙΑΝΟΥΑΡΙΟΥ", "ΦΕΒΡΟΥΑΡΙΟΥ", "ΜΑΡΤΙΟΥ", "ΑΠΡΙΛΙΟΥ", "ΜΑΪΟΥ", "ΙΟΥΝΙΟΥ",
  "ΙΟΥΛΙΟΥ", "ΑΥΓΟΥΣΤΟΥ", "ΣΕΠΤΕΜΒΡΙΟΥ", "ΟΚΤΩΒΡΙΟΥ", "ΝΟΕΜΒΡΙΟΥ", "ΔΕΚΕΜΒΡΙΟΥ"
];

// Club styling themes for Light Theme
const CLUB_THEMES: Record<string, { badge: string; border: string; active: string; dot: string }> = {
  'ΕΟΣ Αθηνών': {
    badge: 'bg-rose-50/50 text-rose-700 border-rose-200/60',
    border: 'hover:border-rose-300',
    dot: 'bg-rose-500',
    active: 'bg-rose-900 border-rose-950 text-white ring-2 ring-rose-900/10'
  },
  'ΑΟΣ': {
    badge: 'bg-emerald-50/50 text-emerald-700 border-emerald-200/60',
    border: 'hover:border-emerald-300',
    dot: 'bg-emerald-500',
    active: 'bg-emerald-900 border-emerald-950 text-white ring-2 ring-emerald-900/10'
  },
  'ΠΟΑ': {
    badge: 'bg-amber-50/50 text-amber-800 border-amber-200/60',
    border: 'hover:border-amber-300',
    dot: 'bg-amber-500',
    active: 'bg-amber-800 border-amber-900 text-white ring-2 ring-amber-800/10'
  },
  'ΕΟΣ Αχαρνών': {
    badge: 'bg-sky-50/50 text-sky-700 border-sky-200/60',
    border: 'hover:border-sky-300',
    dot: 'bg-sky-500',
    active: 'bg-sky-900 border-sky-950 text-white ring-2 ring-sky-900/10'
  },
  'ΕΟΣ Ηλιούπολης': {
    badge: 'bg-indigo-50/50 text-indigo-700 border-indigo-200/60',
    border: 'hover:border-indigo-300',
    dot: 'bg-indigo-500',
    active: 'bg-indigo-900 border-indigo-950 text-white ring-2 ring-indigo-900/10'
  },
  'ΦΟΝΙ': {
    badge: 'bg-orange-50/50 text-orange-700 border-orange-200/60',
    border: 'hover:border-orange-300',
    dot: 'bg-orange-500',
    active: 'bg-orange-800 border-orange-900 text-white ring-2 ring-orange-800/10'
  },
  'ΕΠΟΣ Φυλής': {
    badge: 'bg-pink-50/50 text-pink-700 border-pink-200/60',
    border: 'hover:border-pink-300',
    dot: 'bg-pink-500',
    active: 'bg-pink-900 border-pink-950 text-white ring-2 ring-pink-900/10'
  },
  'ΦΟΠ': {
    badge: 'bg-violet-50/50 text-violet-700 border-violet-200/60',
    border: 'hover:border-violet-300',
    dot: 'bg-violet-500',
    active: 'bg-violet-900 border-violet-950 text-white ring-2 ring-violet-900/10'
  }
};

const defaultTheme = {
  badge: 'bg-slate-50 text-slate-600 border-slate-200/60',
  border: 'hover:border-slate-300',
  dot: 'bg-slate-400',
  active: 'bg-slate-800 border-slate-900 text-white ring-2 ring-slate-800/10'
};

// Group events by month & year first
const groupedEvents = eventsData.reduce((acc: Record<string, typeof eventsData>, event) => {
  const date = new Date(event.startDate);
  const monthName = GREEK_MONTHS[date.getUTCMonth()];
  const year = date.getUTCFullYear();
  const groupKey = `${monthName} ${year}`;
  
  if (!acc[groupKey]) {
    acc[groupKey] = [];
  }
  acc[groupKey].push(event);
  return acc;
}, {});

// Nested grouping: Group each month's events by their exact startDate
const groupedByMonthAndDate = Object.entries(groupedEvents).reduce((acc: Record<string, Record<string, typeof eventsData>>, [monthYear, events]) => {
  const dateGroups = events.reduce((dAcc: Record<string, typeof eventsData>, event) => {
    const dateKey = event.startDate;
    if (!dAcc[dateKey]) {
      dAcc[dateKey] = [];
    }
    dAcc[dateKey].push(event);
    return dAcc;
  }, {});
  
  acc[monthYear] = dateGroups;
  return acc;
}, {});

const totalEvents = eventsData.length;
const uniqueClubs = [...new Set(eventsData.map(e => e.club))];

function getDifficultyTiers(diff?: string): string {
  if (!diff || !diff.trim()) return 'unknown';
  const tokens = diff.split(/[,/&]|ή|(?<!^)\s*[-–—]\s*/).map(t => t.trim()).filter(Boolean);
  const tiers = new Set<string>();
  for (const token of tokens) {
    if (/^(1|1\+|Α|Α\+|A|A\+|ε[υύ]κολ[ηοος]*)$/i.test(token)) {
      tiers.add('easy');
    } else if (/^(2|2\+|Β|Β\+|B|B\+|μ[εέ]τρι[αοος]*)$/i.test(token)) {
      tiers.add('medium');
    } else if (/^([3-9]\+?|[ΧX]\d+\+?|Γ\+?|Δ\+?|[CD]\+?|δ[υύ]σκολ[ηοος]*|απαιτητικ[ήηοος]*)$/i.test(token)) {
      tiers.add('hard');
    }
  }
  return tiers.size > 0 ? Array.from(tiers).join(' ') : 'unknown';
}
---

<Layout mainClass="px-6 md:px-12" footerClass="px-6 md:px-12">
  <style>
    /* Dynamic border separation for visible event rows */
    .event-row:not(.hidden) ~ .event-row:not(.hidden) {
      border-top: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* Targeted event row highlight (when arrived via notification anchor) */
    .event-row:target {
      position: relative;
      background-color: rgba(255, 247, 237, 0.75);
      border-radius: 0.5rem;
      box-shadow: inset 0 0 0 2px rgba(249, 115, 22, 0.85);
    }
  </style>

  <!-- Scroll Progress Bar (Fixed to bottom) -->
  <div class="fixed bottom-0 left-0 w-full h-[3px] z-50 pointer-events-none">
    <div id="scroll-progress-bar" class="h-full bg-orange-500 w-0"></div>
  </div>

  <!-- Dismissible Notifications Callout Banner -->
  <div 
    id="notifications-callout-banner" 
    class="hidden mb-6 bg-white border border-slate-200 rounded-xl px-4 py-3 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-sans"
  >
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-8 h-8 rounded-lg bg-slate-900 text-orange-400 flex items-center justify-center flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
        </svg>
      </div>
      <p class="text-xs sm:text-sm text-slate-700 leading-snug">
        Ενημερωθείτε αυτόματα όταν προστίθενται νέες εξορμήσεις από τους συλλόγους μέσω Telegram ή Email.
      </p>
    </div>
    <div class="flex items-center justify-end gap-2 flex-shrink-0">
      <a 
        href={import.meta.env.BASE_URL + "notifications"} 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition-colors"
      >
        <span>Ενημερώσεις</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <button 
        id="dismiss-notifications-banner-btn" 
        type="button" 
        aria-label="Κλείσιμο ενημέρωσης"
        title="Κλείσιμο"
        class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition-colors focus:outline-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
  
  <div class="flex flex-col lg:flex-row-reverse gap-8 xl:gap-10 items-start">
    <!-- Right Sidebar: Filters Panel (Desktop) -->
    <aside class="hidden lg:block lg:w-[22%] xl:w-[20%] lg:sticky lg:top-28 flex-shrink-0 z-10">
      <!-- Sidebar Title -->
      <div class="flex items-baseline justify-between mb-5 select-none">
        <h2 class="text-mono text-xs font-bold tracking-widest text-slate-600 uppercase">
          ΦΙΛΤΡΑ
        </h2>
        <button 
          id="desktop-reset-filters-btn" 
          type="button" 
          class="hidden text-[11px] font-mono font-medium text-orange-600 hover:text-orange-700 underline underline-offset-2 select-none"
        >
          Επαναφορά
        </button>
      </div>
      <!-- Minimal Compact Filters Dashboard -->
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex flex-col gap-5">
          <!-- Row 1: Search & Total count -->
          <div class="flex flex-col gap-3.5 pb-4 border-b border-slate-100">
            <div class="relative w-full">
              <input 
                type="text" 
                id="search-input" 
                placeholder="Αναζήτηση βουνού..." 
                aria-label="Αναζήτηση βουνού, προορισμού ή συλλόγου"
                class="w-full pl-3 pr-8 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm placeholder-slate-400 focus:outline-none focus:border-slate-900 focus:bg-white transition-all duration-200 font-sans"
              />
              <button 
                id="clear-search-btn" 
                class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 hidden"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <div class="flex items-center justify-between text-mono text-xs text-slate-500 select-none">
              <span>ΒΡΕΘΗΚΑΝ:</span>
              <span class="font-bold text-slate-900 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded text-mono" id="stat-total-count">{totalEvents}</span>
            </div>
          </div>

          <!-- Row 2: Club Filter pills -->
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΣΥΛΛΟΓΟΣ:</span>
            <div class="flex flex-wrap gap-1.5" id="club-filters-container">
              <button 
                data-club-filter="all" 
                class="px-2.5 py-1 rounded border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-club-btn"
              >
                Όλοι ({totalEvents})
              </button>
              {uniqueClubs.map(club => {
                const count = eventsData.filter(e => e.club === club).length;
                const theme = CLUB_THEMES[club] || defaultTheme;
                return (
                  <button
                    data-club-filter={club}
                    data-active-class={theme.active}
                    data-inactive-class={`${theme.badge} ${theme.border} text-slate-600 hover:bg-slate-100`}
                    class={`px-2.5 py-1 rounded border text-xs font-semibold font-sans ${theme.badge} ${theme.border} transition-all duration-200`}
                  >
                    {club} ({count})
                  </button>
                )
              })}
            </div>
          </div>

          <!-- Row 3: Duration Filter pills -->
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΔΙΑΡΚΕΙΑ:</span>
            <div class="flex flex-wrap gap-1.5" id="duration-filters-container">
              <button 
                data-duration-filter="all" 
                class="px-2.5 py-1 rounded border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-duration-btn"
              >
                Όλες
              </button>
              <button 
                data-duration-filter="single" 
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Μονοήμερη
              </button>
              <button 
                data-duration-filter="multi" 
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Πολυήμερη
              </button>
            </div>
          </div>

          <!-- Row 4: Difficulty Filter pills -->
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΔΥΣΚΟΛΙΑ:</span>
            <div class="flex flex-wrap gap-1.5" id="difficulty-filters-container">
              <button 
                data-difficulty-filter="all" 
                class="px-2.5 py-1 rounded border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-difficulty-btn"
              >
                Όλες
              </button>
              <button 
                data-difficulty-filter="easy" 
                title="Β.Δ.: 1, 1+, Α, Α+"
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Εύκολη
              </button>
              <button 
                data-difficulty-filter="medium" 
                title="Β.Δ.: 2, 2+, Β, Β+"
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Μέτρια
              </button>
              <button 
                data-difficulty-filter="hard" 
                title="Β.Δ.: 3+, Χ1–Χ3, Γ, Δ"
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Απαιτητική
              </button>
              <button 
                data-difficulty-filter="unknown" 
                title="Χωρίς ένδειξη Β.Δ."
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
              >
                Άγνωστη
              </button>
            </div>
          </div>

          <!-- Row 5: Favorites / Starred Filter pills -->
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΑΓΑΠΗΜΕΝΑ:</span>
            <div class="flex flex-wrap gap-1.5" id="star-filters-container">
              <button 
                data-star-filter="all" 
                class="px-2.5 py-1 rounded border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-star-btn"
              >
                Όλες
              </button>
              <button 
                data-star-filter="starred" 
                class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200 flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-orange-500 fill-orange-500" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span>Αγαπημένα (<span id="stat-starred-count">0</span>)</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Mobile Floating Filter Pill Trigger (Option A: Split Pill) -->
    <div 
      id="mobile-filter-pill-container" 
      class="lg:hidden fixed left-1/2 -translate-x-1/2 z-40 flex items-center shadow-2xl rounded-full border border-slate-800 bg-slate-900/95 backdrop-blur-md text-white font-sans text-xs select-none transition-all duration-300"
      style="bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));"
    >
      <!-- Main Trigger Button (opens bottom sheet) -->
      <button 
        id="mobile-filter-open-btn"
        type="button"
        class="px-4 py-2.5 flex items-center gap-2 hover:bg-slate-800 active:bg-slate-950 rounded-full transition-colors focus:outline-none"
        aria-label="Άνοιγμα φίλτρων"
      >
        <svg class="w-4 h-4 text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
        </svg>
        <span class="font-semibold tracking-wide">Φίλτρα</span>
        <!-- Filter Active Badge -->
        <span id="mobile-filter-badge" class="hidden bg-orange-500 text-white text-[10px] font-bold font-mono px-1.5 py-0.5 rounded-full min-w-[18px] text-center leading-none">0</span>
      </button>

      <!-- Instant Clear Button (Split option A: visible only when filters active) -->
      <div id="mobile-filter-clear-split" class="hidden items-center">
        <span class="h-4 w-px bg-slate-700"></span>
        <button 
          id="mobile-filter-clear-btn"
          type="button"
          class="px-3 py-2.5 hover:bg-slate-800 active:bg-slate-950 text-slate-300 hover:text-white rounded-r-full transition-colors focus:outline-none"
          title="Καθαρισμός όλων των φίλτρων"
          aria-label="Καθαρισμός όλων των φίλτρων"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Bottom Sheet Backdrop (lg:hidden) -->
    <div 
      id="mobile-filter-drawer-backdrop" 
      class="lg:hidden fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
    ></div>

    <!-- Mobile Bottom Sheet Drawer (lg:hidden) -->
    <div 
      id="mobile-filter-drawer" 
      class="lg:hidden fixed inset-x-0 bottom-0 z-50 max-h-[88vh] bg-white rounded-t-3xl shadow-2xl flex flex-col transition-transform duration-300 ease-out translate-y-full will-change-transform font-sans"
      role="dialog"
      aria-modal="true"
      aria-label="Φίλτρα εξορμήσεων"
    >
      <!-- Grab Handle / Touch Area -->
      <div id="mobile-drawer-drag-area" class="w-full pt-3 pb-1.5 flex justify-center flex-shrink-0 cursor-grab active:cursor-grabbing select-none">
        <div class="w-12 h-1.5 bg-slate-300 rounded-full"></div>
      </div>

      <!-- Drawer Header -->
      <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between flex-shrink-0 select-none">
        <div class="flex items-center gap-2">
          <h2 class="text-mono text-xs font-bold tracking-widest text-slate-900 uppercase">
            ΦΙΛΤΡΑ
          </h2>
          <span class="text-xs text-mono text-slate-400">
            (<span id="mobile-drawer-total-count">{totalEvents}</span>)
          </span>
        </div>
        <div class="flex items-center gap-3">
          <button 
            id="mobile-drawer-reset-btn"
            type="button"
            class="text-xs font-mono font-medium text-orange-600 hover:text-orange-700 transition-colors opacity-40 pointer-events-none"
          >
            Επαναφορά
          </button>
          <button 
            id="mobile-filter-close-btn"
            type="button"
            class="p-1.5 -mr-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none"
            aria-label="Κλείσιμο φίλτρων"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Drawer Scrollable Content -->
      <div class="p-5 space-y-6 overflow-y-auto overscroll-contain flex-grow">
        <!-- Search -->
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΑΝΑΖΗΤΗΣΗ:</span>
          <div class="relative w-full">
            <input 
              type="text" 
              id="mobile-search-input" 
              placeholder="Αναζήτηση βουνού, προορισμού..." 
              aria-label="Αναζήτηση βουνού, προορισμού"
              class="w-full pl-3 pr-8 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:border-slate-900 focus:bg-white transition-all font-sans"
            />
            <button 
              id="mobile-clear-search-btn" 
              type="button"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 hidden"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>

        <!-- Duration Filter (Segmented control style) -->
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΔΙΑΡΚΕΙΑ:</span>
          <div class="grid grid-cols-3 gap-1 p-1 bg-slate-100 border border-slate-200 rounded-xl" id="mobile-duration-filters-container">
            <button 
              data-duration-filter="all" 
              class="py-2 px-1 text-center rounded-lg text-xs font-semibold font-sans transition-all bg-slate-900 text-white shadow-xs active-duration-btn"
            >
              Όλες
            </button>
            <button 
              data-duration-filter="single" 
              class="py-2 px-1 text-center rounded-lg text-xs font-semibold font-sans text-slate-600 hover:text-slate-900 transition-all"
            >
              Μονοήμερη
            </button>
            <button 
              data-duration-filter="multi" 
              class="py-2 px-1 text-center rounded-lg text-xs font-semibold font-sans text-slate-600 hover:text-slate-900 transition-all"
            >
              Πολυήμερη
            </button>
          </div>
        </div>

        <!-- Difficulty Filter -->
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΔΥΣΚΟΛΙΑ:</span>
          <div class="flex flex-wrap gap-1.5" id="mobile-difficulty-filters-container">
            <button 
              data-difficulty-filter="all" 
              class="px-2.5 py-1.5 rounded-lg border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-difficulty-btn"
            >
              Όλες
            </button>
            <button 
              data-difficulty-filter="easy" 
              title="Β.Δ.: 1, 1+, Α, Α+"
              class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
            >
              Εύκολη
            </button>
            <button 
              data-difficulty-filter="medium" 
              title="Β.Δ.: 2, 2+, Β, Β+"
              class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
            >
              Μέτρια
            </button>
            <button 
              data-difficulty-filter="hard" 
              title="Β.Δ.: 3+, Χ1–Χ3, Γ, Δ"
              class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
            >
              Απαιτητική
            </button>
            <button 
              data-difficulty-filter="unknown" 
              title="Χωρίς ένδειξη Β.Δ."
              class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200"
            >
              Άγνωστη
            </button>
          </div>
        </div>

        <!-- Clubs Filter (Multi-select) -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 select-none font-mono">ΣΥΛΛΟΓΟΙ (ΠΟΛΛΑΠΛΗ ΕΠΙΛΟΓΗ):</span>
          </div>
          <div class="flex flex-wrap gap-1.5" id="mobile-club-filters-container">
            <button 
              data-club-filter="all" 
              class="px-2.5 py-1.5 rounded-lg border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-club-btn"
            >
              Όλοι ({totalEvents})
            </button>
            {uniqueClubs.map(club => {
              const count = eventsData.filter(e => e.club === club).length;
              const theme = CLUB_THEMES[club] || defaultTheme;
              return (
                <button
                  data-club-filter={club}
                  data-active-class={theme.active}
                  data-inactive-class={`${theme.badge} ${theme.border} text-slate-600 hover:bg-slate-100`}
                  class={`px-2.5 py-1.5 rounded-lg border text-xs font-semibold font-sans ${theme.badge} ${theme.border} transition-all duration-200`}
                >
                  {club} ({count})
                </button>
              )
            })}
          </div>
        </div>

        <!-- Favorites Filter -->
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-600 block mb-2 select-none font-mono">ΑΓΑΠΗΜΕΝΑ:</span>
          <div class="flex flex-wrap gap-1.5" id="mobile-star-filters-container">
            <button 
              data-star-filter="all" 
              class="px-2.5 py-1.5 rounded-lg border border-slate-900 bg-slate-900 text-white text-xs font-semibold font-sans transition-all duration-200 active-star-btn"
            >
              Όλες
            </button>
            <button 
              data-star-filter="starred" 
              class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold font-sans transition-all duration-200 flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 text-orange-500 fill-orange-500" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
              <span>Αγαπημένα (<span id="mobile-stat-starred-count">0</span>)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Drawer Sticky Bottom Bar with Dynamic CTA -->
      <div 
        class="p-4 border-t border-slate-100 bg-white/95 backdrop-blur-sm sticky bottom-0 select-none"
        style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));"
      >
        <button 
          id="mobile-filter-apply-btn"
          type="button"
          class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:bg-slate-950 text-white font-semibold rounded-xl text-sm flex items-center justify-center gap-2 shadow-sm transition-all focus:outline-none"
        >
          <span>Προβολή</span>
          <span id="mobile-filter-cta-count" class="font-mono text-orange-400 font-bold">{totalEvents}</span>
          <span>εξορμήσεων</span>
          <svg class="w-4 h-4 ml-0.5 text-slate-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Left Column: Calendar Main Content -->
    <div class="w-full lg:w-[78%] xl:w-[80%] flex-grow space-y-10" id="calendar-container">
    {Object.keys(groupedByMonthAndDate).map((monthYear, idx) => {
      const dateGroups = groupedByMonthAndDate[monthYear];
      return (
        <div class="month-group" data-month-year={monthYear}>
          <!-- Minimal Month Separator -->
          <h2 class={`text-mono text-xs font-bold tracking-widest text-slate-600 ${idx === 0 ? 'mt-0' : 'mt-10'} mb-5 uppercase select-none`}>
            {monthYear}
          </h2>

          <!-- Date-Grouped Calendar Card -->
          <div class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-200 shadow-sm overflow-hidden">
            {Object.keys(dateGroups).map(dateStr => {
              const events = dateGroups[dateStr];
              const d = new Date(dateStr);
              const dayNum = d.getUTCDate();
              const dayOfWeek = GREEK_DAYS_FULL[d.getUTCDay()];
              const monthFull = GREEK_MONTHS_FULL[d.getUTCMonth()];
              
              return (
                <div class="date-group flex flex-col md:flex-row items-stretch" data-date={dateStr}>
                  <!-- Date Column (Left) -->
                  <div class="w-full md:w-28 bg-slate-50/40 md:border-r border-slate-200 p-4 md:py-5 flex flex-row md:flex-col items-baseline md:items-start justify-between md:justify-center gap-2 select-none font-mono flex-shrink-0">
                    <span class="text-3xl font-bold text-slate-800 leading-none">
                      {dayNum}
                    </span>
                    <div class="flex md:flex-col items-baseline md:items-start gap-1.5 md:gap-0.5 text-[9px] text-slate-600 font-bold tracking-wider font-mono">
                      <span>{dayOfWeek}</span>
                      <span class="md:hidden">/</span>
                      <span>{monthFull}</span>
                    </div>
                  </div>

                  <!-- Events List (Right) -->
                  <div class="flex-grow px-4 md:px-5 py-1 event-rows-container flex flex-col justify-center">
                    {events.map((event, idx) => {
                      const theme = CLUB_THEMES[event.club] || defaultTheme;
                      const isMultiDay = event.startDate !== event.endDate;
                      const eventId = event.url || `${event.club}_${event.startDate}_${event.title}`;
                      const fallbackId = `${event.club}_${event.startDate}`;
                      const difficultyTiers = getDifficultyTiers(event.difficulty);
                      
                      const searchText = `${event.title} ${event.club} ${monthYear} ${isMultiDay ? 'πολυήμερο' : 'μονοήμερο'} ${event.difficulty ? `Β.Δ. ${event.difficulty}` : ''}`;
                      
                      return (
                        <div 
                          id={getEventAnchor(event)}
                          class="event-row flex items-center gap-2.5 py-3.5 px-2.5 -mx-2.5 rounded-lg transition-all duration-300 scroll-mt-28 target:ring-2 target:ring-orange-500/80 target:bg-orange-50/70"
                          data-club={event.club}
                          data-duration={isMultiDay ? 'multi' : 'single'}
                          data-difficulty={difficultyTiers}
                          data-search-text={searchText}
                          data-event-id={eventId}
                          data-event-fallback-id={fallbackId}
                        >
                          <!-- Star Toggle Button -->
                          <button 
                              type="button"
                              class="star-toggle-btn group p-1 -ml-1 text-slate-300 hover:text-orange-500 focus:outline-none transition-colors duration-150 flex-shrink-0 cursor-pointer"
                              data-event-id={eventId}
                              data-event-fallback-id={fallbackId}
                              aria-label="Προσθήκη στα αγαπημένα"
                              title="Προσθήκη στα αγαπημένα"
                            >
                              <svg class="w-5 h-5 star-icon stroke-current fill-none transition-all duration-150" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385c.116.489-.413.873-.83.619l-4.708-2.884a.563.563 0 00-.582 0l-4.708 2.884c-.417.254-.946-.13-.83-.619l1.285-5.385a.563.563 0 00-.182-.557l-4.204-3.602c-.38-.325-.178-.948.32-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                              </svg>
                            </button>

                            <div class="min-w-0 flex-grow">
                              <!-- Event Title (IBM Plex Sans) on TOP -->
                              <h3 class="text-sm font-semibold text-slate-900 leading-snug mb-1.5 font-sans">
                                <a 
                                  href={event.url} 
                                  target="_blank" 
                                  rel="noopener noreferrer" 
                                  class="group/title hover:text-slate-500 transition-colors duration-150 inline"
                                >
                                  <span>{event.title}{event.difficulty ? ` | Β.Δ.: ${event.difficulty}` : ''}</span>
                                  <svg class="inline-block w-3 h-3 ml-1 -mt-0.5 text-slate-400 group-hover/title:text-slate-600 transition-colors duration-150 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                  </svg>
                                </a>
                              </h3>

                              <div class="flex flex-wrap items-center gap-1.5">
                                <!-- Club Name Badge (Fixed 22px Height) -->
                                <button 
                                  type="button"
                                  data-filter-club={event.club}
                                  class={`inline-flex items-center h-[22px] px-2 border text-[9px] uppercase font-bold tracking-wider font-mono rounded cursor-pointer transition-colors duration-150 ${theme.badge} ${theme.border}`}
                                  title={`Φιλτράρισμα κατά ${event.club}`}
                                >
                                  {event.club}
                                </button>

                                <!-- Excursion date tag if multi-day (Fixed 22px Height) -->
                                {isMultiDay && (
                                  <span class="inline-flex items-center h-[22px] px-2 border border-slate-200 text-[9px] font-bold font-mono text-slate-600 bg-slate-50 rounded select-none">
                                    {event.displayDate}
                                  </span>
                                )}
                              </div>
                            </div>
                          </div>
                        );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 bg-white border border-slate-200 rounded-xl max-w-md mx-auto shadow-sm">
      <h3 class="text-slate-800 text-sm font-bold mb-1 font-sans">Δεν βρέθηκαν εκδρομές</h3>
      <p class="text-slate-400 text-xs font-light mb-5 px-6 leading-relaxed font-sans">
        Δεν υπάρχουν εξορμήσεις που να ταιριάζουν με τα φίλτρα σας. Δοκιμάστε να καθαρίσετε την αναζήτηση.
      </p>
      <button 
        id="reset-filters-btn" 
        class="px-4 py-2 bg-slate-900 text-white text-xs font-bold rounded-lg hover:bg-slate-800 transition-colors"
      >
        Επαναφορά Φίλτρων
      </button>
    </div>

    <!-- Collapsible System Status Logs Panel -->
    <div class="mt-12 border border-slate-200 rounded-xl bg-white shadow-sm overflow-hidden select-none">
      <button 
        id="status-panel-toggle" 
        class="w-full flex items-center justify-between px-5 py-4 text-left font-mono text-[10px] font-bold tracking-wider text-slate-500 hover:bg-slate-50 focus:outline-none transition-colors duration-150"
      >
        <div class="flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
          <span>ΚΑΤΑΣΤΑΣΗ ΣΥΓΧΡΟΝΙΣΜΟΥ (STATUS LOGS)</span>
        </div>
        <svg id="status-panel-chevron" class="w-3 h-3 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div id="status-panel-content" class="hidden border-t border-slate-100 p-5 bg-slate-50/30 font-mono text-[9px] text-slate-500 space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
          <span>ΤΕΛΕΥΤΑΙΑ ΕΝΗΜΕΡΩΣΗ:</span>
          <span class="font-bold text-slate-800">{new Date(statusData.lastUpdated).toLocaleString('el-GR', { timeZone: 'Europe/Athens' })}</span>
        </div>
        <div class="space-y-2.5">
          {statusData.logs.map(log => (
            <div class="border-b border-slate-100 pb-2.5 last:border-0 last:pb-0">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">{log.club}:</span>
                <div class="flex items-center gap-1.5">
                  <span class={`w-1 h-1 rounded-full ${log.status === 'success' ? 'bg-emerald-500' : 'bg-rose-500'}`}></span>
                  <span class={log.status === 'success' ? 'text-slate-600' : 'text-rose-600 font-medium'}>{log.details}</span>
                </div>
              </div>
              {log.fetch && (
                <div class="mt-1 pl-3 text-[8px] text-slate-400 space-y-0.5 font-mono">
                  {log.fetch.map((f: any) => (
                    <div class="flex items-start justify-between gap-4">
                      <span class="break-all pr-2" title={f.url}>{f.url}</span>
                      <span class={`whitespace-nowrap flex-shrink-0 ${f.success ? 'text-slate-500' : 'text-rose-500 font-medium'}`}>
                        {f.success ? `${(f.size/1024).toFixed(1)} KB (HTTP ${f.code})` : `Failed: ${f.status}`}
                      </span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

  <!-- Client-side filtering script -->
  <script>
    // Toggle Status Logs Panel
    const statusPanelToggle = document.getElementById('status-panel-toggle');
    const statusPanelContent = document.getElementById('status-panel-content');
    const statusPanelChevron = document.getElementById('status-panel-chevron');
    
    if (statusPanelToggle && statusPanelContent && statusPanelChevron) {
      statusPanelToggle.addEventListener('click', () => {
        const isHidden = statusPanelContent.classList.contains('hidden');
        if (isHidden) {
          statusPanelContent.classList.remove('hidden');
          statusPanelChevron.classList.add('rotate-180');
        } else {
          statusPanelContent.classList.add('hidden');
          statusPanelChevron.classList.remove('rotate-180');
        }
      });
    }

    // Scroll Progress Bar Logic
    const progressBar = document.getElementById('scroll-progress-bar');
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        
        if (scrollHeight > 0) {
          const scrolled = (scrollTop / scrollHeight) * 100;
          progressBar.style.width = scrolled + '%';
        } else {
          progressBar.style.width = '0%';
        }
      };
      
      window.addEventListener('scroll', updateProgress, { passive: true });
      // Initialize on load
      updateProgress();
    }

    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;
    const mobileClearSearchBtn = document.getElementById('mobile-clear-search-btn') as HTMLButtonElement | null;

    const clubFiltersContainer = document.getElementById('club-filters-container');
    const mobileClubFiltersContainer = document.getElementById('mobile-club-filters-container');
    const durationFiltersContainer = document.getElementById('duration-filters-container');
    const mobileDurationFiltersContainer = document.getElementById('mobile-duration-filters-container');
    const difficultyFiltersContainer = document.getElementById('difficulty-filters-container');
    const mobileDifficultyFiltersContainer = document.getElementById('mobile-difficulty-filters-container');
    const starFiltersContainer = document.getElementById('star-filters-container');
    const mobileStarFiltersContainer = document.getElementById('mobile-star-filters-container');
    
    const eventRows = document.querySelectorAll('.event-row');
    const dateGroups = document.querySelectorAll('.date-group');
    const monthGroups = document.querySelectorAll('.month-group');
    const emptyState = document.getElementById('empty-state');
    const resetFiltersBtn = document.getElementById('reset-filters-btn');
    const desktopResetFiltersBtn = document.getElementById('desktop-reset-filters-btn');
    const mobileDrawerResetBtn = document.getElementById('mobile-drawer-reset-btn');
    
    const statTotalCount = document.getElementById('stat-total-count');
    const mobileDrawerTotalCount = document.getElementById('mobile-drawer-total-count');
    const mobileFilterCtaCount = document.getElementById('mobile-filter-cta-count');
    const statStarredCount = document.getElementById('stat-starred-count');
    const mobileStatStarredCount = document.getElementById('mobile-stat-starred-count');

    // Mobile Bottom Sheet Elements
    const mobileDrawer = document.getElementById('mobile-filter-drawer');
    const mobileDrawerBackdrop = document.getElementById('mobile-filter-drawer-backdrop');
    const mobileDrawerDragArea = document.getElementById('mobile-drawer-drag-area');
    const mobileFilterOpenBtn = document.getElementById('mobile-filter-open-btn');
    const mobileFilterCloseBtn = document.getElementById('mobile-filter-close-btn');
    const mobileFilterApplyBtn = document.getElementById('mobile-filter-apply-btn');
    const mobileFilterClearBtn = document.getElementById('mobile-filter-clear-btn');
    const mobileFilterClearSplit = document.getElementById('mobile-filter-clear-split');
    const mobileFilterBadge = document.getElementById('mobile-filter-badge');

    // Filter State
    let activeClubs = new Set<string>(); // Empty set means "all"
    let activeDuration = 'all';
    let activeDifficulty = 'all';
    let activeStarFilter = 'all';
    let searchQuery = '';

    // Starred Events local storage manager
    const STORAGE_KEY = 'mount_athens_starred_events';

    function getStarredEvents(): Set<string> {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? new Set(JSON.parse(raw)) : new Set();
      } catch (e) {
        return new Set();
      }
    }

    function saveStarredEvents(set: Set<string>) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(set)));
      } catch (e) {
        // Safe fallback
      }
    }

    let starredEvents = getStarredEvents();

    function isEventStarred(eventId: string | null, fallbackId: string | null): boolean {
      if (eventId && starredEvents.has(eventId)) return true;
      if (fallbackId && starredEvents.has(fallbackId)) return true;
      return false;
    }

    function updateStarUI() {
      const allStarBtns = document.querySelectorAll('.star-toggle-btn');
      let activeStarredRows = 0;
      allStarBtns.forEach(btn => {
        const b = btn as HTMLButtonElement;
        const eventId = b.getAttribute('data-event-id');
        const fallbackId = b.getAttribute('data-event-fallback-id');
        const svg = b.querySelector('.star-icon');
        
        if (isEventStarred(eventId, fallbackId)) {
          activeStarredRows++;
          b.classList.remove('text-slate-300');
          b.classList.add('text-orange-500', 'is-starred');
          b.setAttribute('title', 'Αφαίρεση από τα αγαπημένα');
          if (svg) {
            svg.classList.remove('fill-none');
            svg.classList.add('fill-orange-500');
          }
        } else {
          b.classList.remove('text-orange-500', 'is-starred');
          b.classList.add('text-slate-300');
          b.setAttribute('title', 'Προσθήκη στα αγαπημένα');
          if (svg) {
            svg.classList.remove('fill-orange-500');
            svg.classList.add('fill-none');
          }
        }
      });

      if (statStarredCount) {
        statStarredCount.textContent = activeStarredRows.toString();
      }
      if (mobileStatStarredCount) {
        mobileStatStarredCount.textContent = activeStarredRows.toString();
      }
    }

    // Initialize Star UI states on load
    updateStarUI();

    // Star Toggle Click Handler
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const starBtn = target.closest('.star-toggle-btn') as HTMLButtonElement;
      if (!starBtn) return;

      e.preventDefault();
      e.stopPropagation();

      const eventId = starBtn.getAttribute('data-event-id');
      const fallbackId = starBtn.getAttribute('data-event-fallback-id');
      if (!eventId) return;

      if (isEventStarred(eventId, fallbackId)) {
        starredEvents.delete(eventId);
        if (fallbackId) starredEvents.delete(fallbackId);
      } else {
        starredEvents.add(eventId);
        if (fallbackId) starredEvents.add(fallbackId);
      }

      saveStarredEvents(starredEvents);
      updateStarUI();
      applyFilters();
    });

    // Greek Accent Normalizer
    function cleanString(str: string): string {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[άά]/g, 'a')
        .replace(/[έέ]/g, 'e')
        .replace(/[ήή]/g, 'i')
        .replace(/[ίίϊΐ]/g, 'i')
        .replace(/[όό]/g, 'o')
        .replace(/[υύϋΰ]/g, 'y')
        .replace(/[ώώ]/g, 'o');
    }

    function getActiveFilterCount(): number {
      let count = 0;
      if (activeClubs.size > 0) count += activeClubs.size;
      if (activeDuration !== 'all') count++;
      if (activeDifficulty !== 'all') count++;
      if (activeStarFilter !== 'all') count++;
      if (searchQuery.trim() !== '') count++;
      return count;
    }

    function updatePillAndResetState() {
      const count = getActiveFilterCount();

      if (count > 0) {
        if (mobileFilterBadge) {
          mobileFilterBadge.textContent = count.toString();
          mobileFilterBadge.classList.remove('hidden');
        }
        if (mobileFilterClearSplit) {
          mobileFilterClearSplit.classList.remove('hidden');
          mobileFilterClearSplit.classList.add('flex');
        }
        if (mobileFilterOpenBtn) {
          mobileFilterOpenBtn.classList.remove('rounded-full');
          mobileFilterOpenBtn.classList.add('rounded-l-full');
        }
        if (desktopResetFiltersBtn) {
          desktopResetFiltersBtn.classList.remove('hidden');
        }
        if (mobileDrawerResetBtn) {
          mobileDrawerResetBtn.classList.remove('opacity-40', 'pointer-events-none');
        }
      } else {
        if (mobileFilterBadge) {
          mobileFilterBadge.classList.add('hidden');
        }
        if (mobileFilterClearSplit) {
          mobileFilterClearSplit.classList.add('hidden');
          mobileFilterClearSplit.classList.remove('flex');
        }
        if (mobileFilterOpenBtn) {
          mobileFilterOpenBtn.classList.remove('rounded-l-full');
          mobileFilterOpenBtn.classList.add('rounded-full');
        }
        if (desktopResetFiltersBtn) {
          desktopResetFiltersBtn.classList.add('hidden');
        }
        if (mobileDrawerResetBtn) {
          mobileDrawerResetBtn.classList.add('opacity-40', 'pointer-events-none');
        }
      }
    }

    function updateClubButtonsUI() {
      const allClubButtons = document.querySelectorAll('[data-club-filter]');
      allClubButtons.forEach(btn => {
        const b = btn as HTMLButtonElement;
        const clubAttr = b.getAttribute('data-club-filter');
        const isAll = clubAttr === 'all';
        const activeClass = b.getAttribute('data-active-class') || '';
        const inactiveClass = b.getAttribute('data-inactive-class') || '';
        const isMobile = b.closest('#mobile-club-filters-container') !== null;
        const basePadding = isMobile ? 'px-2.5 py-1.5 rounded-lg' : 'px-2.5 py-1 rounded';

        if (isAll) {
          b.className = `${basePadding} border text-xs font-semibold font-sans transition-all duration-200`;
          if (activeClubs.size === 0) {
            b.classList.add('bg-slate-900', 'border-slate-900', 'text-white', 'active-club-btn');
          } else {
            b.classList.add('bg-white', 'border-slate-200', 'text-slate-600', 'hover:bg-slate-50');
          }
        } else if (clubAttr) {
          b.className = `${basePadding} border text-xs font-semibold font-sans transition-all duration-200`;
          if (activeClubs.has(clubAttr)) {
            activeClass.split(' ').forEach(c => { if (c) b.classList.add(c); });
            b.classList.add('active-club-btn');
          } else {
            inactiveClass.split(' ').forEach(c => { if (c) b.classList.add(c); });
          }
        }
      });
    }

    function updateDurationButtonsUI() {
      const allButtons = document.querySelectorAll('[data-duration-filter]');
      allButtons.forEach(btn => {
        const b = btn as HTMLButtonElement;
        const durationAttr = b.getAttribute('data-duration-filter');
        const isMobileContainer = b.closest('#mobile-duration-filters-container') !== null;

        if (isMobileContainer) {
          if (activeDuration === durationAttr) {
            b.className = 'py-2 px-1 text-center rounded-lg text-xs font-semibold font-sans transition-all bg-slate-900 text-white shadow-xs active-duration-btn';
          } else {
            b.className = 'py-2 px-1 text-center rounded-lg text-xs font-semibold font-sans text-slate-600 hover:text-slate-900 transition-all';
          }
        } else {
          b.className = 'px-2.5 py-1 rounded border text-xs font-semibold font-sans transition-all duration-200';
          if (activeDuration === durationAttr) {
            b.classList.add('bg-slate-900', 'border-slate-900', 'text-white', 'active-duration-btn');
          } else {
            b.classList.add('bg-white', 'border-slate-200', 'text-slate-600', 'hover:bg-slate-50');
          }
        }
      });
    }

    function updateDifficultyButtonsUI() {
      const allButtons = document.querySelectorAll('[data-difficulty-filter]');
      allButtons.forEach(btn => {
        const b = btn as HTMLButtonElement;
        const diffAttr = b.getAttribute('data-difficulty-filter');
        const isMobileContainer = b.closest('#mobile-difficulty-filters-container') !== null;
        const basePadding = isMobileContainer ? 'px-2.5 py-1.5 rounded-lg' : 'px-2.5 py-1 rounded';

        b.className = `${basePadding} border text-xs font-semibold font-sans transition-all duration-200`;
        if (activeDifficulty === diffAttr) {
          b.classList.add('bg-slate-900', 'border-slate-900', 'text-white', 'active-difficulty-btn');
        } else {
          b.classList.add('bg-white', 'border-slate-200', 'text-slate-600', 'hover:bg-slate-50');
        }
      });
    }

    function updateStarButtonsUI() {
      const allButtons = document.querySelectorAll('[data-star-filter]');
      allButtons.forEach(btn => {
        const b = btn as HTMLButtonElement;
        const filterAttr = b.getAttribute('data-star-filter');
        const isMobileContainer = b.closest('#mobile-star-filters-container') !== null;
        const basePadding = isMobileContainer ? 'px-2.5 py-1.5 rounded-lg' : 'px-2.5 py-1 rounded';

        b.className = `${basePadding} border text-xs font-semibold font-sans transition-all duration-200 ${filterAttr === 'starred' ? 'flex items-center gap-1.5' : ''}`;
        if (activeStarFilter === filterAttr) {
          b.classList.add('bg-slate-900', 'border-slate-900', 'text-white', 'active-star-btn');
        } else {
          b.classList.add('bg-white', 'border-slate-200', 'text-slate-600', 'hover:bg-slate-50');
        }
      });
    }

    function applyFilters() {
      let visibleCount = 0;
      const cleanQuery = cleanString(searchQuery);

      // Filter rows
      eventRows.forEach(row => {
        const rowElement = row as HTMLElement;
        const clubVal = rowElement.getAttribute('data-club') || '';
        const durationVal = rowElement.getAttribute('data-duration') || '';
        const difficultyVal = rowElement.getAttribute('data-difficulty') || 'unknown';
        const eventId = rowElement.getAttribute('data-event-id') || '';
        const fallbackId = rowElement.getAttribute('data-event-fallback-id') || '';
        const searchRaw = rowElement.getAttribute('data-search-text') || '';
        const cleanSearchText = cleanString(searchRaw);

        const isStarred = isEventStarred(eventId, fallbackId);

        // Multi-select club match: matches if no clubs selected OR if selected set contains club
        const clubMatches = (activeClubs.size === 0 || activeClubs.has(clubVal));
        const durationMatches = (activeDuration === 'all' || durationVal === activeDuration);
        const difficultyMatches = (activeDifficulty === 'all' || difficultyVal.split(' ').includes(activeDifficulty));
        const starMatches = (activeStarFilter === 'all' || isStarred);
        const searchMatches = (cleanQuery === '' || cleanSearchText.includes(cleanQuery));

        if (clubMatches && durationMatches && difficultyMatches && starMatches && searchMatches) {
          rowElement.classList.remove('hidden');
          visibleCount++;
        } else {
          rowElement.classList.add('hidden');
        }
      });

      // Filter Date Groups
      dateGroups.forEach(dg => {
        const dgElement = dg as HTMLElement;
        const visibleRowsInDg = dgElement.querySelectorAll('.event-row:not(.hidden)');
        
        if (visibleRowsInDg.length === 0) {
          dgElement.classList.add('hidden');
        } else {
          dgElement.classList.remove('hidden');
        }
      });

      // Filter Month Groups
      monthGroups.forEach(mg => {
        const mgElement = mg as HTMLElement;
        const visibleDateGroups = mgElement.querySelectorAll('.date-group:not(.hidden)');
        
        if (visibleDateGroups.length === 0) {
          mgElement.classList.add('hidden');
        } else {
          mgElement.classList.remove('hidden');
        }
      });

      // Update counters across desktop, drawer header, and mobile CTA
      if (statTotalCount) statTotalCount.textContent = visibleCount.toString();
      if (mobileDrawerTotalCount) mobileDrawerTotalCount.textContent = visibleCount.toString();
      if (mobileFilterCtaCount) mobileFilterCtaCount.textContent = visibleCount.toString();

      // Update Floating Pill & Reset Buttons
      updatePillAndResetState();

      // Toggle Empty State
      if (visibleCount === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
      }
    }

    // Search Input listeners (Synchronized between desktop and mobile)
    function handleSearchInput(value: string) {
      searchQuery = value;
      if (searchInput && searchInput.value !== value) searchInput.value = value;
      if (mobileSearchInput && mobileSearchInput.value !== value) mobileSearchInput.value = value;

      const hasText = value.trim() !== '';
      if (clearSearchBtn) {
        if (hasText) clearSearchBtn.classList.remove('hidden');
        else clearSearchBtn.classList.add('hidden');
      }
      if (mobileClearSearchBtn) {
        if (hasText) mobileClearSearchBtn.classList.remove('hidden');
        else mobileClearSearchBtn.classList.add('hidden');
      }

      applyFilters();
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        handleSearchInput((e.target as HTMLInputElement).value);
      });
    }

    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('input', (e) => {
        handleSearchInput((e.target as HTMLInputElement).value);
      });
    }

    function clearSearch() {
      handleSearchInput('');
    }

    if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearch);
    if (mobileClearSearchBtn) mobileClearSearchBtn.addEventListener('click', clearSearch);

    // Multi-select Club Click Handlers
    function handleClubClick(button: HTMLButtonElement) {
      const selectedClub = button.getAttribute('data-club-filter') || 'all';

      if (selectedClub === 'all') {
        activeClubs.clear();
      } else {
        if (activeClubs.has(selectedClub)) {
          activeClubs.delete(selectedClub);
        } else {
          activeClubs.add(selectedClub);
        }
      }

      updateClubButtonsUI();
      applyFilters();
    }

    if (clubFiltersContainer) {
      clubFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-club-filter]') as HTMLButtonElement;
        if (button) handleClubClick(button);
      });
    }

    if (mobileClubFiltersContainer) {
      mobileClubFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-club-filter]') as HTMLButtonElement;
        if (button) handleClubClick(button);
      });
    }

    // Duration selection filters (Sync desktop & mobile)
    function handleDurationClick(button: HTMLButtonElement) {
      activeDuration = button.getAttribute('data-duration-filter') || 'all';
      updateDurationButtonsUI();
      applyFilters();
    }

    if (durationFiltersContainer) {
      durationFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-duration-filter]') as HTMLButtonElement;
        if (button) handleDurationClick(button);
      });
    }

    if (mobileDurationFiltersContainer) {
      mobileDurationFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-duration-filter]') as HTMLButtonElement;
        if (button) handleDurationClick(button);
      });
    }

    // Difficulty selection filters (Sync desktop & mobile)
    function handleDifficultyClick(button: HTMLButtonElement) {
      activeDifficulty = button.getAttribute('data-difficulty-filter') || 'all';
      updateDifficultyButtonsUI();
      applyFilters();
    }

    if (difficultyFiltersContainer) {
      difficultyFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-difficulty-filter]') as HTMLButtonElement;
        if (button) handleDifficultyClick(button);
      });
    }

    if (mobileDifficultyFiltersContainer) {
      mobileDifficultyFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-difficulty-filter]') as HTMLButtonElement;
        if (button) handleDifficultyClick(button);
      });
    }

    // Star selection filters (Sync desktop & mobile)
    function handleStarClick(button: HTMLButtonElement) {
      activeStarFilter = button.getAttribute('data-star-filter') || 'all';
      updateStarButtonsUI();
      applyFilters();
    }

    if (starFiltersContainer) {
      starFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-star-filter]') as HTMLButtonElement;
        if (button) handleStarClick(button);
      });
    }

    if (mobileStarFiltersContainer) {
      mobileStarFiltersContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('[data-star-filter]') as HTMLButtonElement;
        if (button) handleStarClick(button);
      });
    }

    // Reset filters (Instant reset across all controls)
    function resetFilters() {
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (mobileSearchInput) mobileSearchInput.value = '';
      if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
      if (mobileClearSearchBtn) mobileClearSearchBtn.classList.add('hidden');

      activeClubs.clear();
      activeDuration = 'all';
      activeDifficulty = 'all';
      activeStarFilter = 'all';

      updateClubButtonsUI();
      updateDurationButtonsUI();
      updateDifficultyButtonsUI();
      updateStarButtonsUI();

      applyFilters();
    }

    if (resetFiltersBtn) resetFiltersBtn.addEventListener('click', resetFilters);
    if (desktopResetFiltersBtn) desktopResetFiltersBtn.addEventListener('click', resetFilters);
    if (mobileDrawerResetBtn) mobileDrawerResetBtn.addEventListener('click', resetFilters);

    if (mobileFilterClearBtn) {
      mobileFilterClearBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        resetFilters();
      });
    }

    // Drawer Open / Close Logic
    function openMobileDrawer() {
      if (!mobileDrawer || !mobileDrawerBackdrop) return;
      mobileDrawerBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      mobileDrawerBackdrop.classList.add('opacity-100');
      mobileDrawer.classList.remove('translate-y-full');
      mobileDrawer.classList.add('translate-y-0');
      document.body.classList.add('overflow-hidden');
    }

    function closeMobileDrawer() {
      if (!mobileDrawer || !mobileDrawerBackdrop) return;
      mobileDrawerBackdrop.classList.remove('opacity-100');
      mobileDrawerBackdrop.classList.add('opacity-0', 'pointer-events-none');
      mobileDrawer.classList.remove('translate-y-0');
      mobileDrawer.classList.add('translate-y-full');
      document.body.classList.remove('overflow-hidden');
    }

    if (mobileFilterOpenBtn) mobileFilterOpenBtn.addEventListener('click', openMobileDrawer);
    if (mobileFilterCloseBtn) mobileFilterCloseBtn.addEventListener('click', closeMobileDrawer);
    if (mobileFilterApplyBtn) mobileFilterApplyBtn.addEventListener('click', closeMobileDrawer);
    if (mobileDrawerBackdrop) mobileDrawerBackdrop.addEventListener('click', closeMobileDrawer);

    // Escape key closes drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer && !mobileDrawer.classList.contains('translate-y-full')) {
        closeMobileDrawer();
      }
    });

    // Touch drag-to-dismiss gesture on mobile drawer
    if (mobileDrawer && mobileDrawerDragArea) {
      let startY = 0;
      let currentY = 0;
      let isDragging = false;

      mobileDrawerDragArea.addEventListener('touchstart', (e) => {
        startY = e.touches[0].clientY;
        currentY = startY;
        isDragging = true;
        mobileDrawer.style.transition = 'none';
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!isDragging || !mobileDrawer) return;
        currentY = e.touches[0].clientY;
        const diffY = currentY - startY;
        if (diffY > 0) {
          mobileDrawer.style.transform = `translateY(${diffY}px)`;
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        if (!isDragging || !mobileDrawer) return;
        isDragging = false;
        mobileDrawer.style.transition = 'transform 0.3s ease-out';
        const diffY = currentY - startY;
        if (diffY > 80) {
          closeMobileDrawer();
          setTimeout(() => {
            if (mobileDrawer) mobileDrawer.style.transform = '';
          }, 300);
        } else {
          mobileDrawer.style.transform = '';
        }
      });
    }

    // Inline club badge click filter (Single club select & scroll to top)
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      
      const badge = target.closest('[data-filter-club]');
      if (!badge) return;

      const selectedClub = badge.getAttribute('data-filter-club');
      if (!selectedClub) return;

      activeClubs.clear();
      activeClubs.add(selectedClub);
      updateClubButtonsUI();
      applyFilters();
      
      // Scroll smoothly back to the top of the page
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Dismissible Notifications Callout Banner
    const NOTIF_BANNER_KEY = 'mount_athens_notifications_banner_dismissed';
    const notifBanner = document.getElementById('notifications-callout-banner');
    const dismissNotifBtn = document.getElementById('dismiss-notifications-banner-btn');

    if (notifBanner) {
      try {
        if (localStorage.getItem(NOTIF_BANNER_KEY) !== '1') {
          notifBanner.classList.remove('hidden');
        }
      } catch (e) {
        notifBanner.classList.remove('hidden');
      }
    }

    if (dismissNotifBtn && notifBanner) {
      dismissNotifBtn.addEventListener('click', () => {
        notifBanner.classList.add('hidden');
        try {
          localStorage.setItem(NOTIF_BANNER_KEY, '1');
        } catch (e) {
          // Safe fallback
        }
      });
    }

    // Anchor target smooth centering & filter reset
    function handleTargetAnchor() {
      const hash = window.location.hash;
      if (!hash || !hash.startsWith('#ev-')) return;
      
      try {
        const targetEl = document.querySelector(hash) as HTMLElement;
        if (!targetEl) return;

        // If target row was filtered out, reset filters so the excursion is visible
        if (targetEl.classList.contains('hidden') || targetEl.closest('.hidden')) {
          resetFilters();
        }

        // Center smoothly in viewport
        setTimeout(() => {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 120);
      } catch (e) {
        // Safe fallback
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      handleTargetAnchor();
    } else {
      window.addEventListener('DOMContentLoaded', handleTargetAnchor);
    }
    window.addEventListener('hashchange', handleTargetAnchor);
  </script>
</Layout>
